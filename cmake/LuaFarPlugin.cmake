# Shared LuaFAR plugin host.
#
# add_luafar_plugin(<Name> [LUA_FILES <file>...])
#
# Builds plugins/<Name>/ into <Name>.dll using the generic luaplug host and
# generates <Name>.lua next to it by concatenating LUA_FILES in order.
# <Name>/_globalinfo.lua must exist and provides the plugin GUID and title.

if(NOT CMAKE_AR)
    message(FATAL_ERROR "LuaFarPlugin.cmake requires CMAKE_AR (MSVC toolchain)")
endif()

get_filename_component(FAR_LUAFAR_DIR "${CMAKE_CURRENT_LIST_DIR}/../third_party/luafar" ABSOLUTE)

if(CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(FAR_LUAFAR_IMPORT_MACHINE x64)
else()
    set(FAR_LUAFAR_IMPORT_MACHINE x86)
endif()

set(FAR_LUAFAR_IMPORT_DIR "${CMAKE_BINARY_DIR}/luafar-import-libs")
file(MAKE_DIRECTORY "${FAR_LUAFAR_IMPORT_DIR}")
set(FAR_LUAFAR_IMPORT_LIBS "")
foreach(_module lua51 luafar3)
    set(_def "${FAR_LUAFAR_DIR}/def/${_module}.def")
    set(_lib "${FAR_LUAFAR_IMPORT_DIR}/${_module}.lib")
    add_custom_command(
        OUTPUT "${_lib}"
        COMMAND "${CMAKE_AR}" /nologo "/def:${_def}" "/machine:${FAR_LUAFAR_IMPORT_MACHINE}" "/out:${_lib}"
        DEPENDS "${_def}"
        COMMENT "Creating ${_module} import library"
        VERBATIM
    )
    list(APPEND FAR_LUAFAR_IMPORT_LIBS "${_lib}")
endforeach()

if(NOT TARGET luafar_import_libs)
    add_custom_target(luafar_import_libs DEPENDS ${FAR_LUAFAR_IMPORT_LIBS})
endif()

function(add_luafar_plugin target)
    cmake_parse_arguments(ARG "" "" "LUA_FILES" ${ARGN})

    if(NOT ARG_LUA_FILES)
        set(ARG_LUA_FILES "lua/plugin.lua")
    endif()

    if(NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/_globalinfo.lua")
        message(FATAL_ERROR "${target}: _globalinfo.lua not found in ${CMAKE_CURRENT_SOURCE_DIR}")
    endif()

    add_library(${target} SHARED
        "${FAR_LUAFAR_DIR}/luaplug.c"
        "${FAR_LUAFAR_DIR}/luaplug.def"
        "${FAR_LUAFAR_DIR}/styled_viewer.cpp"
    )

    add_dependencies(${target} luafar_import_libs)
    target_link_libraries(${target} PRIVATE ${FAR_LUAFAR_IMPORT_LIBS})

    target_include_directories(${target} PRIVATE
        "${FAR_LUAFAR_DIR}"
        "${FAR_LUAFAR_DIR}/lua"
        "${CMAKE_SOURCE_DIR}/sdk"
    )

    target_compile_definitions(${target} PRIVATE
        UNICODE
        _UNICODE
        WIN32_LEAN_AND_MEAN
        NOMINMAX
        EXPORT_OPEN
        EXPORT_EXITFAR
        EXPORT_CONFIGURE
        EXPORT_PROCESSCONSOLEINPUT
        EXPORT_PROCESSPANELINPUT
    )

    set(_generated "${CMAKE_CURRENT_BINARY_DIR}/${target}.lua")
    file(WRITE "${_generated}" "-- Generated by cmake/LuaFarPlugin.cmake; do not edit.\n")
    foreach(_lua IN LISTS ARG_LUA_FILES)
        if(IS_ABSOLUTE "${_lua}")
            set(_src "${_lua}")
        else()
            set(_src "${CMAKE_CURRENT_SOURCE_DIR}/${_lua}")
        endif()
        if(NOT EXISTS "${_src}")
            message(FATAL_ERROR "${target}: Lua source not found: ${_src}")
        endif()
        file(READ "${_src}" _content)
        file(APPEND "${_generated}" "\n${_content}\n")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_src}")
    endforeach()

    add_custom_command(TARGET ${target} POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E copy_if_different
            "${_generated}"
            "$<TARGET_FILE_DIR:${target}>/${target}.lua"
        COMMAND ${CMAKE_COMMAND} -E copy_if_different
            "${CMAKE_CURRENT_SOURCE_DIR}/_globalinfo.lua"
            "$<TARGET_FILE_DIR:${target}>/_globalinfo.lua"
        VERBATIM
    )

    set_target_properties(${target} PROPERTIES
        OUTPUT_NAME ${target}
        SUFFIX ".dll"
        RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/plugins/${target}"
        LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/plugins/${target}"
        ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/plugins/${target}"
        MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>"
    )
endfunction()
